# =============================================================================
# CodeMastery – .gitignore
# Monorepo layout: backend/ (Maven + Spring Boot), frontend/ (Vite + React),
# e2e/ (Playwright), infrastructure/ (Docker Compose), docs/, sample-data/.
#
# Rule of thumb: ignore generated output, local tooling state and secrets only.
# Source, migrations, docs, sample data, lock files and the Maven wrapper
# MUST stay tracked.
# =============================================================================


# -----------------------------------------------------------------------------
# Secrets and local environment (NEVER commit these)
# -----------------------------------------------------------------------------
# Real environment files are local-only. The template is tracked.
.env
.env.*
!.env.example

# Private keys, certificates and keystores
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# Conventional local secrets locations
secrets/
.secrets/
credentials.json
service-account*.json


# -----------------------------------------------------------------------------
# Operating system artifacts
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini


# -----------------------------------------------------------------------------
# IDE / editor metadata
# -----------------------------------------------------------------------------
# JetBrains (IntelliJ IDEA, WebStorm)
.idea/
*.iml
*.ipr
*.iws
backend/out/

# Visual Studio Code
.vscode/

# Eclipse / Spring Tool Suite
.classpath
.project
.settings/
.factorypath
.apt_generated/
.sts4-cache/
backend/bin/

# NetBeans
nbproject/private/
nbbuild/
nbdist/

# Vim / Emacs / generic editor leftovers
*.swp
*.swo
*~
\#*\#
.\#*


# -----------------------------------------------------------------------------
# Backend – Java / Maven / Spring Boot
# -----------------------------------------------------------------------------
backend/target/

# Maven wrapper: the wrapper scripts and .mvn/wrapper/ files are tracked.
# (No blanket *.jar rule on purpose, so maven-wrapper.jar is never ignored.)
!backend/.mvn/wrapper/maven-wrapper.jar
!backend/.mvn/wrapper/maven-wrapper.properties

# Maven misc
**/dependency-reduced-pom.xml
**/pom.xml.versionsBackup
**/release.properties
**/.flattened-pom.xml

# JVM crash and heap dumps
hs_err_pid*
replay_pid*
*.hprof

# Local Spring Boot overrides (keep application.yml tracked)
backend/src/main/resources/application-local.yml
backend/src/main/resources/application-local.yaml
backend/src/main/resources/application-local.properties
backend/src/test/resources/application-local.yml
backend/src/test/resources/application-local.yaml
backend/src/test/resources/application-local.properties

# Test / coverage output generated by build plugins
backend/target/surefire-reports/
backend/target/failsafe-reports/
backend/target/site/


# -----------------------------------------------------------------------------
# Frontend – Node / Vite / React / TypeScript
# -----------------------------------------------------------------------------
# Dependencies (package-lock.json stays tracked)
node_modules/

# Build output and caches
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/node_modules/.vite/
*.tsbuildinfo

# Test and coverage output
frontend/coverage/
frontend/.nyc_output/

# Local frontend env overrides (covered by the .env rules above, listed for clarity)
frontend/.env.local
frontend/.env.*.local

# Package-manager debug logs and caches
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.eslintcache
.stylelintcache


# -----------------------------------------------------------------------------
# End-to-end tests – Playwright
# -----------------------------------------------------------------------------
e2e/node_modules/
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/
e2e/playwright/.cache/
e2e/playwright/.auth/

# Same artifacts if Playwright is ever run from the repository root
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/


# -----------------------------------------------------------------------------
# Logs, temporary files and local scratch data
# -----------------------------------------------------------------------------
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.orig
*.rej

# Local scratch folders (not used by the build)
scratch/
.scratch/


# -----------------------------------------------------------------------------
# Containers and local infrastructure state
# -----------------------------------------------------------------------------
# Docker Compose configuration, Dockerfiles, .dockerignore files and
# infrastructure/vm/deploy.sh are tracked. Only local volume dumps are ignored.
infrastructure/**/*.dump
infrastructure/**/*.sql.gz


# -----------------------------------------------------------------------------
# Explicitly KEEP (documentation of intent – these are not ignored above)
# -----------------------------------------------------------------------------
# .env.example
# backend/mvnw, backend/mvnw.cmd, backend/.mvn/wrapper/*
# backend/src/main/resources/db/migration/*.sql   (Flyway migrations)
# frontend/package-lock.json, e2e/package-lock.json
# docs/**, docs/api/openapi.yaml
# sample-data/**  (seed SQL and sample materials)
# .github/**

# Microsoft Office temporary/lock files
~$*.docx
~$*.xlsx
~$*.pptx