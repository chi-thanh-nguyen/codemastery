# =============================================================================
# CodeMastery – Environment Template
# =============================================================================
# Usage:
#   cp .env.example .env
# Replace every active <SET_ME...> placeholder before use. Use unquoted KEY=value
# lines: the backend imports .env as Java properties, not as a shell script.
# NEVER commit .env, real secrets, or real lecturer/demo credentials.
# Commented settings are optional or reserved for pending integrations. Compose
# uses an explicit backend allowlist; optional host settings are not forwarded.
# Current application defaults below are verified from application.yml; they are
# not approved production, security, upload, or scheduler/business-policy values.
# Local Compose publishes loopback-only ports:
#   frontend http://localhost:5173; backend http://localhost:8080
#   PostgreSQL localhost:5432; MinIO API http://localhost:9000
#   MinIO Console http://localhost:9001
# Browser API integration, E2E, and production deployment remain unimplemented.
# Named PostgreSQL/MinIO volumes survive `down`; `down -v` deletes local data.


# -----------------------------------------------------------------------------
# A. PostgreSQL Infrastructure Initialization
# -----------------------------------------------------------------------------
# Used by the local PostgreSQL service, on first initialization of an empty volume.
# For disposable LOCAL development, explicitly set matching actual values in
# POSTGRES_DB/DB_NAME, POSTGRES_USER/DB_USER, POSTGRES_PASSWORD/DB_PASSWORD.
# The namespaces remain distinct; Compose does not alias one to the other.
# This local simplification is NOT production database credential policy.
POSTGRES_DB=<SET_ME_LOCAL_DATABASE>
POSTGRES_USER=<SET_ME_LOCAL_DATABASE_USER>
POSTGRES_PASSWORD=<SET_ME_STRONG_PASSWORD>


# -----------------------------------------------------------------------------
# B. Backend Datasource
# -----------------------------------------------------------------------------
# Required local Compose inputs; explicitly match the POSTGRES_* values above.
DB_NAME=<SET_ME_MATCHING_LOCAL_DATABASE>
DB_USER=<SET_ME_MATCHING_LOCAL_DATABASE_USER>
DB_PASSWORD=<SET_ME_STRONG_PASSWORD>
# Host-development examples/current application defaults. Compose overrides
# DB_HOST with postgres and DB_PORT with 5432 inside the backend container.
# DB_HOST=localhost
# DB_PORT=5432
# DB_POOL_SIZE=10


# -----------------------------------------------------------------------------
# C. MinIO Administration
# -----------------------------------------------------------------------------
# Administrative/root credentials used by MinIO and its one-shot initializer.
# Never use these as backend application storage credentials.
MINIO_ROOT_USER=<SET_ME_LOCAL_MINIO_ADMIN>
MINIO_ROOT_PASSWORD=<SET_ME_STRONG_PASSWORD>


# -----------------------------------------------------------------------------
# D. Backend Object Storage
# -----------------------------------------------------------------------------
# Application storage credentials are conceptually separate from MinIO root
# credentials. STORAGE_ACCESS_KEY must differ from MINIO_ROOT_USER. Compose's
# initializer provisions this application identity and its bucket-scoped policy.
# Required backend secret inputs: no application defaults.
STORAGE_ACCESS_KEY=<SET_ME_SEPARATE_STORAGE_APPLICATION_USER>
STORAGE_SECRET_KEY=<SET_ME_STRONG_SECRET>
# Host-development examples/current application defaults. Compose overrides
# STORAGE_ENDPOINT with http://minio:9000 and path-style access with true.
# STORAGE_BUCKET and STORAGE_REGION are shared by backend and initializer;
# the local fallbacks are codemastery and us-east-1.
# STORAGE_ENDPOINT=http://localhost:9000
# STORAGE_REGION=us-east-1
# STORAGE_BUCKET=codemastery
# STORAGE_PATH_STYLE_ACCESS=true


# -----------------------------------------------------------------------------
# E. Security / CORS
# -----------------------------------------------------------------------------
# Required backend secret input: no application default; use at least 256 random bits.
JWT_SECRET=<SET_ME_LONG_RANDOM_SECRET>
# Optional settings shown with current application defaults, not final policy.
# JWT and reset TTL values use ISO-8601 durations; CORS origins are comma-separated.
# JWT_EXPIRATION=PT1H
# PASSWORD_RESET_TOKEN_TTL=PT30M
# CORS_ALLOWED_ORIGINS=http://localhost:5173


# -----------------------------------------------------------------------------
# F. Backend Runtime / Operations
# -----------------------------------------------------------------------------
# Optional settings shown with current application defaults.
# SERVER_PORT=8080
# MAX_UPLOAD_SIZE=20MB
# LOG_LEVEL_ROOT=INFO
# LOG_LEVEL_APP=INFO
# SCHEDULING_ENABLED=true
# Scheduler timing values use ISO-8601 durations; these are not business policy.
# ATTEMPT_AUTO_SUBMIT_DELAY=PT30S
# DEADLINE_REMINDER_DELAY=PT15M
# DEADLINE_REMINDER_LEAD_TIME=PT24H

# Optional Spring profile selection, not a ${...} placeholder in application.yml.
# This example is not a default. The prod profile currently adds ECS JSON console
# logging only; it is not a complete production configuration.
# SPRING_PROFILES_ACTIVE=prod


# -----------------------------------------------------------------------------
# G. Frontend – Vite (Public Build-Time Configuration)
# -----------------------------------------------------------------------------
# Optional public build-time configuration, with root environment-file loading
# and Vite typing. The bootstrap currently has no API consumer or application URL
# fallback. Compose supplies http://localhost:8080 as the local build-ARG default.
# The bootstrap builds without this value. NEVER expose secrets through VITE_*.
# Browser JavaScript must use the host URL, not http://backend:8080.
# Changing this value requires rebuilding the frontend image; setting an Nginx
# runtime environment value does not rewrite the built Vite bundle.
# VITE_API_BASE_URL=http://localhost:8080


# -----------------------------------------------------------------------------
# H. E2E – Playwright (Pending)
# -----------------------------------------------------------------------------
# Pending Playwright/E2E configuration; URL, accounts, roles, authentication flow,
# and account lifecycle are not defined here. Never commit real credentials.
# E2E_BASE_URL=<SET_ME>
# E2E_USERNAME=<SET_ME>
# E2E_PASSWORD=<SET_ME>
